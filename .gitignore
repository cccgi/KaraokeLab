.DS_Store
/.build
/.swiftpm
/.ortbuild
/Packages
Package.resolved
xcuserdata/
DerivedData/
*.xcodeproj/project.xcworkspace/xcuserdata/
/dist
# Bộ test hồi quy nội bộ (--regress-test) — file âm thanh nặng, không đưa lên git.
# manifest.json + *.txt (lời) vẫn giữ lại vì nhẹ và là tài liệu tham chiếu hữu ích.
/.regression/*.wav
dist-release/
# Mô hình ONNX nặng (64-303MB, vượt trần 100MB của GitHub) — không đưa lên git.
# Lấy lại từ gói bàn giao (5_KaraokeApp_source_with_git.zip đi kèm models riêng, hoặc
# tải lại UVR-MDX-NET-Voc_FT / mdx23c-vocinst / mms-aligner theo README) rồi chép đúng
# đường dẫn dưới đây trước khi `swift build` — Package.swift cần file THẬT tồn tại trên đĩa.
/Sources/KaraokeMaker/Resources/*.onnx
# Thư mục build theo kiến trúc của Scripts/package-release.sh (~800 MB mỗi cái) — không đưa lên git.
/.build-release-arm64/
/.build-release-x86_64/
# Thử nghiệm whisper.cpp cũ (09/2026), Package.swift KHÔNG dùng — chỉ nằm trên iMac.
/vendor/whisper.xcframework/
# Bản dựng kiểm thử giao diện + ảnh chụp/đo của Scripts/ui-check.sh (ảnh có lời bài hát — không đưa lên git công khai).
/.build-guitest/
/.ui-check/
